# ============================================
# AgentCart — Environment Configuration
# ============================================
# Copy this file to .env and adjust values.
# No paid API keys required.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://agentcart:agentcart_secret@localhost:5432/agentcart
POSTGRES_USER=agentcart
POSTGRES_PASSWORD=agentcart_secret
POSTGRES_DB=agentcart

# --- Ollama (LLM) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# --- Embeddings ---
EMBEDDING_MODEL=nomic-embed-text

# --- Voice: Speech-to-Text (faster-whisper) ---
WHISPER_URL=http://localhost:9000
WHISPER_MODEL=base

# --- Voice: Text-to-Speech (Kokoro) ---
KOKORO_URL=http://localhost:8880
KOKORO_VOICE=af_heart

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend ---
VITE_API_URL=http://localhost:8000
